# LJM Intelligence backend — copy to .env locally, set the real values in Render env for prod.
# NEVER commit .env. Only .env.example (this file) is tracked.

APP_ENV=development
LOG_LEVEL=info

# Neon Postgres — pooled connection, keep sslmode=require & channel_binding=require.
# postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=

# Comma-separated CORS origins. Add the Vercel origin here in prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview URLs, e.g. https://freight-demo-[a-z0-9-]+\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=

# Gemini — used from Slice 3. Env-driven model names (they rotate).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_SCORING=gemini-3.5-flash-lite
GEMINI_MODEL_DISCOVERY=gemini-3.5-flash-lite

# Shared secret between the scheduler (GitHub Actions) and POST /crawl/run.
CRON_SECRET=

# Frontend origin (canonical Vercel URL) — used to build unsubscribe links.
FRONTEND_ORIGIN=http://localhost:3000

# Demo safety net. Real outreach requires BOTH this=false AND settings.auto_send_enabled=true.
SIMULATED_DELIVERY=true

# Sender identity for outreach (Slice 6+).
OUTREACH_FROM_EMAIL=safety@ljminternational.com
OUTREACH_FROM_NAME=LJM International
# CAN-SPAM physical address, printed in every real mail footer.
OUTREACH_POSTAL_ADDRESS=22 Troy Lane, Lincoln Park NJ 07035

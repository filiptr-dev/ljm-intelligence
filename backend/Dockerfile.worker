# Worker image. Shares the API's codebase + env — only the entrypoint differs.
# Procrastinate's `queue:work` equivalent is `python -m procrastinate … worker`.
#
# R3 (max tasks / max time): we bound the worker to --one-shot=False with
# periodic self-restart handled by Docker's `restart: always` + the --delete-
# jobs sweep. R4 (pool size) is set via DB_POOL_SIZE/DB_POOL_OVERFLOW env on
# the stack. R5 (scale) is `docker compose up -d --scale worker=4`.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.4.20 /uv /bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    UV_PYTHON_DOWNLOADS=0 \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --no-dev --frozen || uv sync --no-dev

COPY . .

RUN useradd --system --no-create-home worker
USER worker

# `procrastinate --app=app.shared.queue.app worker` is the canonical
# command; we rely on the module's App to self-register tasks via
# `import_paths`. `--one-shot=false` is the default; `--queues default`
# matches the plan's single-queue shape.
CMD ["sh", "-c", "procrastinate --app=app.shared.queue.app worker --queues=default"]

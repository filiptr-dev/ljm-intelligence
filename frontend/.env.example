# LJM Intelligence frontend (Vercel). Copy to .env.local for dev.
#
# Two backend URLs, one server-only and one browser-safe:
#
# - BACKEND_URL — server-only. Used by the legacy /api/* proxy handlers for
#   the crawler + email tools. Kept off the browser so CRON_SECRET can travel
#   with it in a proxy request without leaking.
# - NEXT_PUBLIC_API_URL — public. Used by the typed lib/api/ client (currently
#   the Shipper Finder page and, over time, the other tools as they migrate).
#   The browser hits the FastAPI origin directly; CORS on the backend allows
#   http://localhost:3100 and the Vercel production origin.
#
# On Vercel Preview + Production, set NEXT_PUBLIC_API_URL to the Render API URL
# (https://ljm-intelligence-api.onrender.com). See frontend/README.md.

# Backend origin (Render URL in prod, http://localhost:8765 locally).
BACKEND_URL=http://localhost:8765

# Browser-safe base URL for the typed lib/api/ client (Shipper Finder etc.).
NEXT_PUBLIC_API_URL=http://localhost:8765

# Shared secret with the FastAPI /crawl/run endpoint + the GitHub Actions cron.
# Must match backend CRON_SECRET. Never expose to the browser.
CRON_SECRET=
